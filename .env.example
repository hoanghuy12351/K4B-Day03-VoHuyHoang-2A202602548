# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "anthropic", "openrouter", hoặc "mock" (offline)
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000

# Web MVP
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false
DATABASE_PATH=data/healthcare_mvp.db
# Chỉ cấu hình khi frontend và API chạy khác tên miền, phân tách bằng dấu phẩy.
CORS_ORIGINS=
